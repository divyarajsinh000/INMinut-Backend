# INMinut Backend Environment Variables Configuration Template
# Copy this file to .env and replace placeholders with actual secrets in production.
# NEVER COMMIT REAL SECRETS OR PRIVATE KEYS TO SOURCE CONTROL.

PORT=5000
NODE_ENV=development

# Database Connection
# MONGO_URI=mongodb+srv://<USER>:<PASSWORD>@cluster.mongodb.net/brekingapp
MONGO_URI=mongodb://127.0.0.1:27017/breakingapp

# Authentication & Session Security
# Generate a strong 256-bit random secret (e.g., node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your-secure-random-32-byte-hex-secret
JWT_EXPIRES_IN=24h

# Frontend Client Origin (for CORS)
FRONTEND_URL=http://localhost:5173

# Email Transport (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="INMinut Security <no-reply@inminut.com>"

# Firebase Admin SDK Credentials (Keep private key on one line with escaped \n characters)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Push Notification Access Token (Optional)
EXPO_PUSH_ACCESS_TOKEN=

# AWS S3 Storage Credentials (Optional)
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
